// Prisma schema for the e-card platform foundation.
// Database URL lives in prisma7.config.ts (not here) so credentials stay in env.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ORGANIZER
  STAFF
}

enum AuthorizationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventType {
  WEDDING
  CORPORATE
  OTHER
}

enum EventStatus {
  DRAFT
  AUTHORIZED
  SUSPENDED
  PUBLISHED
  CANCELLED
  COMPLETED
}

// Lifecycle status of a card *template* (admin library).
enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Card types a guest can hold (Step 8 / spec section 7).
enum CardType {
  STANDARD
  PREMIUM
}

// Generation state of a guest's personalized E-Card (Step 8 / spec section 7).
// SENT is a legacy value from the old browser-share flow. New deliveries are
// tracked separately by DeliveryStatus; cardStatus no longer records delivery.
enum CardStatus {
  PENDING
  GENERATED
  SENT
}

// WhatsApp delivery state for a guest's personalized E-Card. NOT_SENT is the
// default; NOT_CONFIGURED means a send was attempted while no provider was
// configured; FAILED means the configured provider rejected the send.
enum DeliveryStatus {
  NOT_SENT
  NOT_CONFIGURED
  SENT
  FAILED
}

enum AttendanceStatus {
  REGISTERED
  CHECKED_IN
  NO_SHOW
  LEFT
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  username            String?              @unique
  phone               String?              @unique
  name                String
  passwordHash        String
  role                Role                 @default(ORGANIZER)
  authorizationStatus AuthorizationStatus  @default(PENDING)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  events         Event[]
  cardTemplates  CardTemplate[]
  payments       Payment[]
  reviewedPayments Payment[] @relation("PaymentReviewedBy")
  checkIns       Attendance[]   @relation("AttendanceCheckedInBy")
  auditLogs      AuditLog[]

  @@index([role])
  @@index([authorizationStatus])
  @@index([createdAt])
  @@map("users")
}

model PricingTier {
  id        String   @id @default(uuid()) @db.Uuid
  minGuests Int
  maxGuests Int
  price     Float
  active    Boolean  @default(true)
  events    Event[]
  payments  Payment[]
}

model CardTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  imageUrl    String
  // Detected personalization placeholders (normalized pixel boxes, colors).
  // Null means no placeholders were found — the renderer uses its legacy
  // fallback layout (bottom band + QR badge).
  layout      Json?
  status      TemplateStatus @default(DRAFT)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  events      Event[]

  @@index([status])
  @@index([createdById])
  @@map("card_templates")
}

model Event {
  id             String       @id @default(uuid()) @db.Uuid
  ownerId        String       @db.Uuid
  pricingTierId  String       @db.Uuid
  cardTemplateId String?      @db.Uuid
  type           EventType    @default(OTHER)
  title          String
  slug           String       @unique
  coupleNames    String?
  description    String?
  location       String?
  startsAt       DateTime
  endsAt         DateTime?
  quotedAmount   Decimal      @db.Decimal(12, 2)
  paymentInstructions String?
  guestCount     Int          @default(0)
  status         EventStatus  @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pricingTier    PricingTier  @relation(fields: [pricingTierId], references: [id], onDelete: Restrict)
  cardTemplate   CardTemplate? @relation(fields: [cardTemplateId], references: [id], onDelete: SetNull)
  invitation     Invitation?  // <--- Added relation for Prisma recognition
  guests         Guest[]
  attendances    Attendance[]
  payments       Payment[]

  @@index([ownerId])
  @@index([pricingTierId])
  @@index([cardTemplateId])
  @@index([status, startsAt])
  @@map("events")
}

model Invitation {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @unique @db.Uuid
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateTheme   String   @default("classic-blue")
  customMessage   String?
  accentColor     String   @default("#2563eb")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Guest {
  id         String     @id @default(uuid()) @db.Uuid
  eventId    String     @db.Uuid
  fullName   String
  email      String?
  phone      String?
  whatsapp   String?
  cardType   CardType   @default(STANDARD)
  cardStatus CardStatus @default(PENDING)
  // Opaque, server-generated ticket identity. Never contains guest PII.
  qrToken    String     @unique
  // Pre-generated PNG so a card is ready as soon as the guest is added.
  // Never selected by guest list responses; kept in sync via fingerprint.
  cardPng         Bytes?
  cardFingerprint String?
  // WhatsApp delivery is separate from generation: only the provider service
  // may move this to SENT, and only after the provider confirms the send.
  deliveryStatus    DeliveryStatus @default(NOT_SENT)
  deliveredAt       DateTime?
  deliveryProvider  String?
  deliveryMessageId String?
  deliveryError     String?
  plusOnes   Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@unique([eventId, email])
  @@index([eventId])
  @@index([email])
  @@index([deliveryStatus])
  @@map("guests")
}

model Attendance {
  id            String           @id @default(uuid()) @db.Uuid
  eventId       String           @db.Uuid
  guestId       String           @db.Uuid
  checkedInById String?          @db.Uuid
  status        AttendanceStatus @default(REGISTERED)
  checkedInAt   DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest       Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  checkedInBy User? @relation("AttendanceCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@unique([eventId, guestId])
  @@index([eventId, status])
  @@index([guestId])
  @@index([checkedInById])
  @@map("attendances")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  eventId        String?       @db.Uuid
  pricingTierId  String        @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("TSH") @db.Char(3)
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?
  paymentReference String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?       @db.Uuid
  rejectionReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  event       Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  pricingTier PricingTier @relation(fields: [pricingTierId], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("PaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([eventId])
  @@index([pricingTierId])
  @@index([reviewedById])
  @@index([createdAt])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
