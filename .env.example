# Supabase Postgres - copy from Dashboard -> Connect.
# Do not commit real secrets. Keep these in .env only.
#
# DIRECT_URL: Session pooler (port 5432) or direct db.<project>.supabase.co.
#             Used by Prisma Migrate, never by the running app.
# DATABASE_URL: Transaction pooler (port 6543) for Vercel/serverless, or the
#               session pooler (port 5432) for a long-lived Node server.
# URL-encode special characters in the database password.

DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt"
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt"

# Required for remote databases. Production refuses to start without verified
# TLS; never use sslmode=no-verify or uselibpqcompat=true.
# Supabase's public root CA is committed at certs/supabase-prod-ca-2021.crt
# (SHA-256 80:70:25:AD:50:D4:ED:21:9D:2C:9C:7D:29:9C:00:4F:82:4E:B0:0C:F7:F6:5A:FE:F6:07:D0:7B:72:E6:CA:FA).
# Use an absolute sslrootcert path if the file is outside the project root.
#
# Long-lived Node server alternative (session pooler):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt"

# Supabase Storage - private bucket for uploaded card design images.
# Create the bucket in Dashboard -> Storage (Public bucket = OFF).
# The service-role/secret key is server-only and must never be prefixed with
# NEXT_PUBLIC_. The app refuses new template uploads in production when these
# are missing; existing data-URL template records remain readable.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-or-secret-key"
SUPABASE_STORAGE_BUCKET=ecard-assets

# Session JWT signing secret (>= 32 chars, unique). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production - the app refuses to start without a strong secret.
# Never reuse this secret across environments.
JWT_SECRET=replace-with-a-random-48-byte-base64url-string

# WhatsApp card delivery (optional).
# Leave the access token and phone number id unset to keep delivery disabled.
# The UI will show "not configured" and will never claim a card was sent.
# Provider: Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional Graph API version. Defaults to v23.0.
# WHATSAPP_API_VERSION=v23.0
#
# Business-initiated messages need an approved template with an image header.
# Body example: "Hi {{1}}, here is your card for {{2}}."
# When this is unset, the provider falls back to a free-form image message,
# which Meta only accepts inside an open 24-hour customer-service window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Body parameter sources, in order. Allowed: guestName, eventTitle, none.
# Defaults to guestName,eventTitle.
# WHATSAPP_TEMPLATE_BODY_FIELDS=guestName,eventTitle
# Optional recipient for `npm run test:whatsapp` (international format, digits).
# WHATSAPP_TEST_RECIPIENT=

# One-time admin seed. Set these only in the local shell/CI job that runs
# `npm run db:seed`; do not add the password to Vercel runtime variables unless
# you intentionally run the seed there. The seed updates the admin password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=Mwakki
SEED_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
